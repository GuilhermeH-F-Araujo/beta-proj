{
  "name": "perc3-auth",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check:env": "npm --prefix server run check:env",
    "doctor": "npm --prefix server run doctor",
    "publish:recovery-logo": "npm --prefix server run publish:recovery-logo",
    "publish:auth-emails": "npm --prefix server run publish:auth-emails",
    "smoke": "node scripts/teste-inicial.mjs",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "build:render": "node scripts/build-render.mjs",
    "start": "npm --prefix server start",
    "test:ui": "node --import ./client/scripts/test-loader.mjs --import ./server/node_modules/tsx/dist/loader.mjs --test ./client/scripts/usabilidade-v78.test.mjs"
  }
}

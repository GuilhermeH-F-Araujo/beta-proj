{
  "name": "perc3-auth-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:motorcycle-status": "node --import tsx --test scripts/status-motocicleta.test.mjs",
    "test:motorcycle-brands": "node --import tsx --test scripts/marcas-motocicleta.test.mjs",
    "test:client-url": "node --test scripts/url-cliente.test.mjs",
    "dev": "node --watch --import tsx src/index.ts",
    "check:env": "node scripts/verificar-ambiente.mjs",
    "doctor": "node scripts/diagnostico.mjs",
    "doctor:image": "node scripts/diagnostico-imagem-executor.mjs",
    "publish:recovery-logo": "node scripts/publicar-logo-recuperacao.mjs",
    "publish:auth-emails": "node scripts/publicar-emails-autenticacao.mjs",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
